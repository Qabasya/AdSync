# LMS REST API
LMS_BASE_URL=https://example.com/wp-json/fs-lms/v1
FS_LMS_AD_HMAC_SECRET=

# Job polling
JOBS_POLL_SECONDS=3
JOBS_LIMIT=50

# Reconciliation ("пылесос")
RECONCILE_INTERVAL_HOURS=6
RECONCILE_GRACE_MINUTES=15
RECONCILE_MAX_DISABLE=10
RECONCILE_MAX_DISABLE_PCT=20

# Active Directory (LDAPS)
LDAP_HOST=11.11.11.11
LDAP_PORT=636
LDAP_CA_CERT=/app/config/ldap-ca.pem
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
AD_UPN_SUFFIX=fs.loc
AD_OU_DISABLED=
AD_OU_FALLBACK=
SUBJECTS_FILE=/app/config/subjects.yaml

# Runtime
DATA_DIR=/data
TZ_NAME=Europe/Moscow
DAILY_SUMMARY_TIME=

# Optional integrations
LOKI_URL=

# Период лога "adsync жив" (сводка журнала), секунды
HEARTBEAT_INTERVAL_SECONDS=3600

# Local API (health/status/reconcile)
API_PORT=8091
