# Подпись запросов сайта (то же значение, что FS_LMS_AD_HMAC_SECRET в wp-config.php сайта)
FS_LMS_AD_HMAC_SECRET=
# Допустимое расхождение часов сайта и сервиса, секунды (окно анти-replay)
HMAC_MAX_SKEW_SECONDS=300

# Публичный API для сайта (HTTPS; порт проброшен на роутере только для IP сайта)
PUBLIC_PORT=8443
TLS_CERT_FILE=/app/config/tls/server.crt
TLS_KEY_FILE=/app/config/tls/server.key

# Сверка ("пылесос"): список присылает сайт раз в сутки; предохранители — здесь
RECONCILE_GRACE_MINUTES=15
RECONCILE_MAX_DISABLE=10
RECONCILE_MAX_DISABLE_PCT=20

# Active Directory (LDAPS)
LDAP_HOST=11.11.11.11
LDAP_PORT=636
LDAP_CA_CERT=/app/config/ldap-ca.pem
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
AD_UPN_SUFFIX=fs.loc
AD_OU_DISABLED=
AD_OU_FALLBACK=
# Настройки новых и существующих учёток (приводятся при зачислении и смене пароля).
# Путь к перемещаемому профилю: {username} — логин. Одинарные кавычки обязательны:
# без них docker compose подставит переменную вместо $ в имени скрытой шары.
AD_PROFILE_PATH_TEMPLATE='\\dc.fs.loc\Profiles$\{username}\profile'
# Галка «Срок действия пароля не ограничен».
AD_PASSWORD_NEVER_EXPIRES=true
SUBJECTS_FILE=/app/config/subjects.yaml

# Runtime
DATA_DIR=/data
TZ_NAME=Europe/Moscow
DAILY_SUMMARY_TIME=

# Optional integrations
LOKI_URL=

# Период лога "adsync жив" (сводка журнала), секунды
HEARTBEAT_INTERVAL_SECONDS=3600

# Локальный API (health/status), наружу не пробрасывается
API_PORT=8091
